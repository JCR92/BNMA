```{r rho}

# CALCULATE THE SD_diff and the SMD 
# DEFINE Correlation Coefficient ##

  rho_s1 = 0.3
  rho_s2 = 0.4
  rho_s3 = 0.5
  rho_s4 = 0.6
  rho_s5 = 0.7
  rho_s6 = 0.8

# calculate SMD #

# rho 0.3
dataset_1$sd_diff_s1 <- sqrt(dataset_1$post_SD^2 + dataset_1$pre_SD^2
                        - 2 * rho_s1 * dataset_1$post_SD * dataset_1$pre_SD)

dataset_1$SMD_s1 <- dataset_1$Mean_Diff / ((sqrt((dataset_1$post_SD^2 + dataset_1$pre_SD^2) / 2))
                    / (sqrt(2 *(1 - rho_s1))))

dataset_1$se_diff_s1 <- sqrt(((2 * (1 - rho_s1)) / dataset_1$post_N )
                        + (dataset_1$SMD_s1^2 / (2 * dataset_1$post_N)))



